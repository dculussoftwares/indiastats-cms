# Database connection string
DATABASE_URI=mongodb://127.0.0.1/your-database-name

# Or use a Postgress connection string
#DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Azure Blob Storage for media files (optional - only needed in production)
# Get these values from Terraform output after deploying infrastructure
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=stindiastatsmedia;...
# AZURE_STORAGE_CONTAINER_NAME=indiastats-cms-media
# AZURE_STORAGE_ACCOUNT_BASEURL=https://stindiastatsmedia.blob.core.windows.net

# Google Analytics 4 Measurement ID (public in production, keep in .env.local for dev)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
