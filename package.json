{
  "name": "indiastats-cms",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3010",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation\" pnpm exec playwright test --config=playwright.config.ts",
    "test:smoke": "cross-env NODE_OPTIONS=\"--no-deprecation\" pnpm exec playwright test tests/e2e/smoke.spec.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "eci:push": "npx tsx scripts/eci-push.mts",
    "remotion:preview": "remotion studio src/remotion/index.tsx",
    "remotion:render": "remotion render src/remotion/index.tsx ReelCard out/reel.mp4",
    "remotion:thumbnail": "remotion still src/remotion/index.tsx ReelCard out/thumbnail.png --frame=210"
  },
  "dependencies": {
    "@microsoft/clarity": "1.0.2",
    "@payloadcms/admin-bar": "3.68.4",
    "@payloadcms/db-postgres": "3.68.4",
    "@payloadcms/live-preview-react": "3.68.4",
    "@payloadcms/next": "3.68.4",
    "@payloadcms/plugin-form-builder": "3.68.4",
    "@payloadcms/plugin-nested-docs": "3.68.4",
    "@payloadcms/plugin-redirects": "3.68.4",
    "@payloadcms/plugin-search": "3.68.4",
    "@payloadcms/plugin-seo": "3.68.4",
    "@payloadcms/richtext-lexical": "3.68.4",
    "@payloadcms/storage-azure": "3.68.4",
    "@payloadcms/ui": "3.68.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "1.2.8",
    "@remotion/cli": "4.0.394",
    "@supabase/supabase-js": "2.87.1",
    "@tanstack/react-table": "8.21.3",
    "chroma-js": "3.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "html-to-image": "1.11.13",
    "leaflet": "1.9.4",
    "lucide-react": "^0.378.0",
    "mixpanel-browser": "2.73.0",
    "next": "15.4.10",
    "next-sitemap": "^4.2.3",
    "payload": "3.68.4",
    "postgres": "3.4.9",
    "posthog-js": "1.367.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "7.45.4",
    "react-leaflet": "5.0.0",
    "recharts": "3.6.0",
    "remotion": "4.0.394",
    "sharp": "0.34.2",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/react": "16.3.0",
    "@types/chroma-js": "3.1.2",
    "@types/escape-html": "^1.0.2",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.5.4",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "copyfiles": "^2.4.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.7",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.3",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
